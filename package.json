{
  "name": "wainscoting-designer",
  "version": "2.0.0",
  "type": "module",
  "description": "Architectural Wainscoting Designer, Layout Engine, and Carpentry Calculator",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode singlefile --outDir dist-single",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "wainscoting",
    "carpentry",
    "woodworking",
    "calculator",
    "cut-list",
    "moulding",
    "board-and-batten"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.0.0",
    "vitest": "^3.0.0"
  }
}
